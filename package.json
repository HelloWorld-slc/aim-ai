{
  "name": "aim-ai",
  "displayName": "AIM AI",
  "description": "VEX AIM classroom coding: AI assistance, local references, project exchange and VEX integration.",
  "version": "0.4.0",
  "publisher": "aim-ai-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "VEX",
    "AIM",
    "AI",
    "Python",
    "education"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onView:aimAI.assistant"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "test:robot": "node tests/robot-integration.cjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aimAI",
          "title": "AIM AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aimAI": [
        {
          "id": "aimAI.assistant",
          "name": "AIM AI",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "aimAI.open",
        "title": "AIM AI: 打开助手"
      },
      {
        "command": "aimAI.configure",
        "title": "AIM AI: 配置模型 API"
      },
      {
        "command": "aimAI.testConnection",
        "title": "AIM AI: 测试模型连接"
      },
      {
        "command": "aimAI.clearKey",
        "title": "AIM AI: 删除当前 API 密钥"
      },
      {
        "command": "aimAI.newProject",
        "title": "AIM AI: 新建 AIM 项目"
      },
      {
        "command": "aimAI.importProject",
        "title": "AIM AI: 导入 .aimpython"
      },
      {
        "command": "aimAI.exportProject",
        "title": "AIM AI: 导出 .aimpython"
      },
      {
        "command": "aimAI.check",
        "title": "AIM AI: 检查当前程序"
      },
      {
        "command": "aimAI.docs",
        "title": "AIM AI: 打开 AIM 资料"
      },
      {
        "command": "aimAI.restore",
        "title": "AIM AI: 恢复 AI 修改前的代码"
      },
      {
        "command": "aimAI.deviceStatus",
        "title": "AIM AI: 查看 VEX 设备状态"
      },
      {
        "command": "aimAI.download",
        "title": "AIM AI: 下载到机器人（实验性）"
      },
      {
        "command": "aimAI.run",
        "title": "AIM AI: 运行机器人程序（实验性）"
      },
      {
        "command": "aimAI.stop",
        "title": "AIM AI: 请求停止机器人"
      },
      {
        "command": "aimAI.newChat",
        "title": "AIM AI: 新对话（保留历史）"
      },
      {
        "command": "aimAI.robotGuide",
        "title": "AIM AI: 机器人配网与调试教程"
      },
      {
        "command": "aimAI.robotStop",
        "title": "AIM AI: 停止 / 取消远程调试"
      }
    ],
    "configuration": {
      "title": "AIM AI",
      "properties": {
        "aimAI.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "服务商 API 根地址；可通过模型预设填写。密钥通过配置命令保存。"
        },
        "aimAI.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "服务商提供的模型 ID。"
        },
        "aimAI.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 16384,
          "description": "单次回答最大输出 token 数。"
        },
        "aimAI.autoExport": {
          "type": "boolean",
          "default": false,
          "description": "保存 AIM 主程序时更新项目 dist 文件夹内的 .aimpython。不会刷新官方应用。"
        },
        "aimAI.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "可选 Python 可执行文件路径。空白时尝试系统 Python；用于语法检查及创建机器人调试环境（需 3.10+）。"
        },
        "aimAI.experimentalHardware": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "启用尚待实机验证的 VEX 官方扩展下载/运行桥接。此开关与 Wi-Fi 机器人调试独立，模型不能下载或运行项目。"
        },
        "aimAI.provider": {
          "type": "string",
          "default": "custom",
          "enum": [
            "custom",
            "deepseek",
            "qwen",
            "kimi",
            "glm",
            "openai",
            "claude",
            "gemini"
          ],
          "scope": "application",
          "description": "当前模型服务预设。通过 AIM AI 的模型页配置；不会自动发送请求。"
        },
        "aimAI.protocol": {
          "type": "string",
          "default": "chat-completions",
          "enum": [
            "chat-completions",
            "anthropic"
          ],
          "scope": "application",
          "description": "模型 API 协议：Chat Completions 或 Anthropic Messages。"
        },
        "aimAI.openAfterExport": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "手动导出成功后自动用 VEXcode AIM 打开项目。保存触发的自动导出只更新文件。"
        },
        "aimAI.applicationPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "VEXcode AIM.exe 的完整路径。留空时检测 Windows 常见安装位置。"
        },
        "aimAI.thinkingEffort": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "off",
            "enabled",
            "minimal",
            "low",
            "medium",
            "high",
            "max"
          ],
          "scope": "application",
          "description": "思考强度。推荐在助手中选择，菜单按模型支持范围调整；不支持的档位回到预设默认。"
        },
        "aimAI.streamResponses": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "使用流式 API，逐步显示回答及服务商公开返回的思考内容。不支持流式的自定义接口可关闭。"
        },
        "aimAI.robotAutoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "已安装调试环境并保存连接设置后，允许 AI 按需自动连接和读取状态，不再询问连接授权。运动测试仍需用户点击执行。"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "eventsource-parser": "^4.1.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloWorld-slc/aim-ai.git"
  },
  "bugs": {
    "url": "https://github.com/HelloWorld-slc/aim-ai/issues"
  },
  "homepage": "https://github.com/HelloWorld-slc/aim-ai"
}
